[Unit]
Description=IASantiago offline eval (Recall/MRR) sobre los 9 golden sets por tema
# Informativo: el stack lo levanta el cron de horario escolar, no esta unidad.
# No se pone Requires=iasantiago-rag.service a proposito, para que el eval no
# pueda arrancar el stack fuera de horario y quedarselo la GPU.
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/iasantiago-rag
ExecStart=/usr/bin/python3 /opt/iasantiago-rag/scripts/eval_nightly.py

# Por debajo de los 45 min que deja la ventana (14:15 -> cierre 15:00): mejor
# que lo mate systemd, dejando el fallo escrito, a que lo mate el
# `docker compose stop` del cron a media tirada.
TimeoutStartSec=2400

[Install]
WantedBy=multi-user.target
