[Unit]
Description=Cap RTX 5090 board power to reduce PCIe/power transients
Documentation=man:nvidia-smi(1)
# The card defaults to its 600 W maximum. Capping the board trims the
# millisecond-scale power transients that are the usual cause of Xid 79
# ("GPU has fallen off the bus"), which took this machine down on
# 2026-09-16. Allowed range on this board is 400-600 W.
After=nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/default/nvidia-power-limit
# Run as root: nvidia-smi creates /dev/nvidia* if the nodes are not there yet.
ExecStart=/bin/sh -c '/usr/bin/nvidia-smi --power-limit=${NVIDIA_POWER_LIMIT_W:-450}'
# Reapplied by nvidia-recover.sh, because reloading the modules resets the
# board to its default limit.

[Install]
WantedBy=multi-user.target
